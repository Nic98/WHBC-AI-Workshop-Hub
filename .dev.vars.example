# Local administrator credentials. Generate a PBKDF2-SHA256 hash with at least
# 210,000 iterations and keep the real values in the ignored .dev.vars file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH="pbkdf2-sha256$210000$BASE64_SALT$BASE64_HASH"

# Submission alerts. With Resend's onboarding sender, the recipient must match
# the email used for the Resend account until a school sending domain is verified.
RESEND_API_KEY=re_example
SUBMISSION_NOTIFY_EMAIL=teacher@example.com
SUBMISSION_FROM_EMAIL="AI Workshop Hub <onboarding@resend.dev>"
